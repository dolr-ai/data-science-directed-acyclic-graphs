# Shared across ansuman-1 and ansuman-2.

AIRFLOW_IMAGE=ghcr.io/yral/data-science-airflow-selfhosted:2.10.5
AIRFLOW_UID=50000
AIRFLOW_DB_USER=airflow_app
AIRFLOW_DB_PASSWORD=replace-me
PGBOUNCER_PORT=6432

# Prefer a stable RabbitMQ cluster endpoint. If a local TCP frontend is added
# later, point this at 127.0.0.1 instead.
AIRFLOW_BROKER_URL=amqp://airflow_broker:replace-me@replace-with-rabbitmq-endpoint:5672/airflow

AIRFLOW_FERNET_KEY=replace-with-shared-fernet-key
AIRFLOW_WEBSERVER_SECRET_KEY=replace-with-shared-flask-secret
AIRFLOW__SENTRY__SENTRY_ON=False
AIRFLOW__SENTRY__SENTRY_DSN=
AIRFLOW_REMOTE_LOG_FOLDER=s3://replace-me/airflow/prod
HETZNER_S3_ENDPOINT_URL=https://replace-me
HETZNER_S3_ACCESS_KEY=replace-me
HETZNER_S3_SECRET_KEY=replace-me

AIRFLOW_PARALLELISM=32
AIRFLOW_WORKER_CONCURRENCY=8
AIRFLOW_DEFAULT_QUEUE=airflow_tasks
AIRFLOW_DAG_DIR_LIST_INTERVAL=30
AIRFLOW_MIN_FILE_PROCESS_INTERVAL=30

AIRFLOW_LOG_DIR=/var/lib/airflow/logs
AIRFLOW_TMP_DIR=/var/lib/airflow/tmp
AIRFLOW_SECRETS_DIR=/etc/airflow/secrets

# Required by exported recsys-dags. Keep real values only in shared.env, never in git.
RECSYS_PROJECT_ID=hot-or-not-feed-intelligence
REGION=us-central1
RECSYS_GCP_CREDENTIALS=
RECSYS_SERVICE_ACCOUNT=
RECSYS_GOOGLE_CHAT_WEBHOOK=
RECSYS_SERVICE_REDIS_INSTANCE_ID=
RECSYS_SERVICE_REDIS_HOST=
RECSYS_PROXY_REDIS_HOST=
RECSYS_SERVICE_REDIS_PORT=
RECSYS_PROXY_REDIS_PORT=
RECSYS_SERVICE_REDIS_AUTHKEY=
RECSYS_USE_REDIS_PROXY=
RECSYS_SERVICE_REDIS_CLUSTER_ENABLED=
RECSYS_DEV_MODE=
